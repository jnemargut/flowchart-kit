{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flowchart Kit board",
  "type": "object",
  "required": [
    "title",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "frames": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "description": "the name on the frame (and the slide title in Play)"
          },
          "near": {
            "description": "[\"right of\" | \"left of\" | \"below\" | \"above\", \"<frame id>\"]: placed next to that frame, in the nearest free spot",
            "type": "array",
            "items": [
              {
                "enum": [
                  "right of",
                  "left of",
                  "below",
                  "above"
                ]
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "dir": {
            "enum": [
              "right",
              "down"
            ],
            "description": "\"right\" (default) or \"down\": which way its flow runs"
          },
          "notes": {
            "type": "string",
            "description": "speaker notes for when it's a slide"
          },
          "url": {
            "type": "string",
            "description": "a web address for the whole frame (the spec, the epic, the prototype)"
          },
          "shapes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "points"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "rect",
                    "ellipse",
                    "line",
                    "arrow",
                    "path",
                    "text"
                  ]
                },
                "points": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "fill": {
                  "enum": [
                    "none",
                    "light",
                    "mid",
                    "dark",
                    "white"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "color": {
                  "anyOf": [
                    {
                      "enum": [
                        "ink",
                        "grey",
                        "red",
                        "blue",
                        "green",
                        "yellow",
                        "none"
                      ]
                    },
                    {
                      "type": "string",
                      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
                      "description": "Any color as a hex, e.g. \"#e8b04b\"."
                    }
                  ]
                },
                "weight": {
                  "enum": [
                    "thin",
                    "normal",
                    "thick"
                  ]
                },
                "size": {
                  "enum": [
                    "s",
                    "m",
                    "l",
                    "xl"
                  ]
                },
                "front": {
                  "type": "boolean",
                  "description": "Drawn in front of the boxes and cards."
                }
              }
            }
          },
          "size": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "box",
              "pill",
              "diamond",
              "sticky",
              "text",
              "stamp",
              "link",
              "card"
            ],
            "description": "box | pill | diamond | sticky | text | stamp | link | card (default box)"
          },
          "text": {
            "type": "string",
            "description": "the words on it"
          },
          "frame": {
            "type": "string",
            "description": "the frame it lives in (leave out for the loose area)"
          },
          "color": {
            "anyOf": [
              {
                "enum": [
                  "yellow",
                  "pink",
                  "blue",
                  "green",
                  "gray"
                ]
              },
              {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
                "description": "Any color as a hex, e.g. \"#e8b04b\"."
              }
            ],
            "description": "stickies: yellow | pink | blue | green | gray (default yellow), or any hex like \"#e8b04b\""
          },
          "near": {
            "type": "string",
            "description": "stickies and text: the id of the node to sit beside; stamps: the node to sit on top of"
          },
          "icon": {
            "enum": [
              "cursor",
              "star",
              "smiley",
              "meh",
              "frown",
              "heart",
              "thumbs-up",
              "thumbs-down",
              "question",
              "alert",
              "check",
              "cross",
              "idea",
              "flag",
              "clock",
              "eye",
              "fire",
              "dollar"
            ],
            "description": "stamps: cursor | star | smiley | meh | frown | heart | thumbs-up | thumbs-down | question | alert | check | cross | idea | flag | clock | eye | fire | dollar"
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "stamps on a node: [x, y] as fractions of it (default [1, 0], its top-right corner)"
          },
          "ref": {
            "type": "string",
            "description": "cards: a path to a storyboard, panel, wireframe, screen or image"
          },
          "url": {
            "type": "string",
            "description": "a web address; link cards show it, anything else gets a clickable link badge"
          },
          "sketch": {
            "type": "boolean",
            "description": "image cards: false shows the picture as it is (default: sketchified in grays to match)"
          },
          "crop": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "cards: [left, top, right, bottom] as fractions of the picture (the editor's Crop button writes it)"
          },
          "product": {
            "type": "boolean",
            "description": "true draws it teal: this is where the product shows up"
          },
          "size": {
            "enum": [
              "s",
              "m",
              "l",
              "xl"
            ],
            "description": "text size: s | m (default) | l | xl"
          },
          "fill": {
            "anyOf": [
              {
                "enum": [
                  "white",
                  "paper",
                  "light",
                  "mid",
                  "dark",
                  "yellow",
                  "pink",
                  "blue",
                  "green",
                  "teal",
                  "none"
                ]
              },
              {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
                "description": "Any color as a hex, e.g. \"#e8b04b\"."
              }
            ],
            "description": "boxes, pills, decisions, text: white | paper | light | mid | dark | yellow | pink | blue | green | teal | none, or any hex like \"#e8b04b\" (a color swatch is a small box with a hex fill)"
          },
          "stroke": {
            "anyOf": [
              {
                "enum": [
                  "ink",
                  "grey",
                  "red",
                  "blue",
                  "green",
                  "orange",
                  "teal",
                  "none"
                ]
              },
              {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
                "description": "Any color as a hex, e.g. \"#e8b04b\"."
              }
            ],
            "description": "border color: ink | grey | red | blue | green | orange | teal | none, or any hex"
          },
          "weight": {
            "enum": [
              "thin",
              "normal",
              "thick"
            ],
            "description": "border weight: thin | normal (default) | thick"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "description": "node id"
          },
          "to": {
            "type": "string",
            "description": "node id"
          },
          "label": {
            "type": "string",
            "description": "a word or two on the arrow (\"yes\", \"no\", \"after 10 min\")"
          },
          "style": {
            "enum": [
              "solid",
              "dashed",
              "dotted"
            ],
            "description": "\"solid\" (default), \"dashed\" (maybe, later) or \"dotted\" (a weak or implied link)"
          },
          "shape": {
            "enum": [
              "curved",
              "angled",
              "straight"
            ],
            "description": "\"curved\", \"angled\" (right-angle elbows) or \"straight\" (default: the board's \"connectors\", else curved)"
          },
          "head": {
            "enum": [
              "end",
              "start",
              "both",
              "none"
            ],
            "description": "arrowheads: \"end\" (default), \"start\", \"both\" or \"none\" (a plain line)"
          },
          "color": {
            "anyOf": [
              {
                "enum": [
                  "ink",
                  "grey",
                  "red",
                  "blue",
                  "green",
                  "orange",
                  "teal"
                ]
              },
              {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
                "description": "Any color as a hex, e.g. \"#e8b04b\"."
              }
            ],
            "description": "ink | grey (default) | red | blue | green | orange | teal, or any hex"
          },
          "weight": {
            "enum": [
              "thin",
              "normal",
              "thick"
            ],
            "description": "thin | normal (default) | thick"
          },
          "fromSide": {
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ],
            "description": "which side it leaves from: \"left\" | \"right\" | \"top\" | \"bottom\" (default: the layout picks)"
          },
          "toSide": {
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ],
            "description": "which side it arrives on (same choices)"
          },
          "bend": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "[dx, dy]: pulls the arrow's middle that far from where the layout puts it, to route around things. Editor-owned: the designer drags the arrow's middle handle. Leave it out."
          }
        }
      }
    },
    "present": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Frame ids in presenting order."
    },
    "transition": {
      "enum": [
        "fade",
        "cut"
      ]
    },
    "connectors": {
      "enum": [
        "curved",
        "angled",
        "straight"
      ],
      "description": "How links are drawn unless a link says otherwise."
    },
    "shapes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "rect",
              "ellipse",
              "line",
              "arrow",
              "path",
              "text"
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "fill": {
            "enum": [
              "none",
              "light",
              "mid",
              "dark",
              "white"
            ]
          },
          "text": {
            "type": "string"
          },
          "color": {
            "anyOf": [
              {
                "enum": [
                  "ink",
                  "grey",
                  "red",
                  "blue",
                  "green",
                  "yellow",
                  "none"
                ]
              },
              {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
                "description": "Any color as a hex, e.g. \"#e8b04b\"."
              }
            ]
          },
          "weight": {
            "enum": [
              "thin",
              "normal",
              "thick"
            ]
          },
          "size": {
            "enum": [
              "s",
              "m",
              "l",
              "xl"
            ]
          },
          "front": {
            "type": "boolean",
            "description": "Drawn in front of the boxes and cards."
          }
        }
      }
    },
    "markup": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "points"
          ],
          "properties": {
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "color": {
              "anyOf": [
                {
                  "enum": [
                    "ink",
                    "grey",
                    "red",
                    "blue",
                    "green",
                    "yellow"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
                  "description": "Any color as a hex, e.g. \"#e8b04b\"."
                }
              ]
            }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "description": "Written by the editor: x/y pin a node in place (frame coordinates); dx/dy nudge an unpinned one; w/h size it.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "dx": {
            "type": "number"
          },
          "dy": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          }
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
